# EAS upload filter (replaces .gitignore when this file exists).
# .env* is intentionally NOT listed so EXPO_PUBLIC_* are available to Metro on local/cloud builds.
# Keep secrets out of git; only include them in the EAS tarball via this file.

# Native projects: regenerated on EAS via expo prebuild (must not upload local copies)
/ios
/android

# OSX
#
.DS_Store

# Xcode
#
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# Android/IntelliJ
#
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# node.js
#
node_modules/
npm-debug.log
yarn-error.log

# fastlane
#
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# eslint
.eslintcache

# vscode
.vscode/*

# Documentation (keep markdown, ignore images/binaries)
/docs/*.jpeg
/docs/*.png
/docs/*.jpg
/docs/*.docx
/docs/*.html

# Local tooling (font metadata patching — see scripts/patch-font-names.py)
.venv-fontpatch/
# Expo
.expo
dist/
web-build/

# Firebase / Play credentials are gitignored but must be uploaded to EAS
# so app.config.ts (googleServicesFile) and submit profiles can resolve them.
# google-play-service-account.json stays excluded; only EAS submit needs it.
/credentials/google-play-service-account.json

# Apple Sign In private keys (must never be committed)
*.p8
AuthKey_*.p8

# Android release keystores (EAS download — never commit)
*.jks
@*.jks

# EAS CLI credential export (never upload)
credentials.json

# Local build artifacts
build-*.apk
build-*.aab
*.apk
*.aab
