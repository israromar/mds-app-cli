import { NavigationContainer } from '@react-navigation/native';
<% if (hasAuth || hasOnboarding) { -%>
import { useEffect, useState } from 'react';
<% } -%>
import { I18nextProvider } from 'react-i18next';

import { rootNavigationReference } from '@/navigation/rootNavigationReference';
import { useTheme } from '@/theme';
import i18n from '@/translations';

<% if (hasOnboarding) { -%>
import { STORAGE_KEYS } from '@/constants/storageKeys';
import { AppIntro } from '@/features/onboarding/screens/AppIntro';
import { appStorage } from '@/storage/appStorage';
<% } -%>
<% if (hasAuth) { -%>
import { Startup } from '@/features/startup/screens/Startup';
import { isSupabaseConfigured, supabase } from '@/services/supabase';
import { useAuthStore } from '@/store/authStore';
<% } -%>

import { AppNavigator } from './navigators/AppNavigator';
<% if (hasAuth) { -%>
import { AuthNavigator } from './navigators/AuthNavigator';
<% } -%>

function ApplicationNavigator() {
  const { navigationTheme } = useTheme();
<% if (hasOnboarding) { -%>
  const [introDone, setIntroDone] = useState(
    () => appStorage.getBoolean(STORAGE_KEYS.ftueIntroCompleted) ?? false,
  );

  const finishIntro = () => {
    appStorage.set(STORAGE_KEYS.ftueIntroCompleted, true);
    setIntroDone(true);
  };
<% } -%>
<% if (hasAuth) { -%>
  const loading = useAuthStore((state) => state.loading);
  const isAuthenticated = useAuthStore((state) => state.isAuthenticated);
  const isPasswordRecovery = useAuthStore((state) => state.isPasswordRecovery);
  const setSession = useAuthStore((state) => state.setSession);
  const clearSession = useAuthStore((state) => state.clearSession);

  useEffect(() => {
    void useAuthStore.getState().hydrateSession();

    if (!isSupabaseConfigured) {
      return;
    }

    const { data } = supabase.auth.onAuthStateChange((event, session) => {
      if (
        event === 'SIGNED_IN' ||
        event === 'USER_UPDATED' ||
        event === 'TOKEN_REFRESHED'
      ) {
        setSession(session?.user ?? null);
      } else if (event === 'SIGNED_OUT') {
        clearSession();
      }
    });
    return () => {
      data.subscription.unsubscribe();
    };
  }, [setSession, clearSession]);
<% } -%>

  const renderContent = () => {
<% if (hasOnboarding) { -%>
    if (!introDone) {
      return <AppIntro onDone={finishIntro} />;
    }
<% } -%>
<% if (hasAuth) { -%>
    if (loading) {
      return <Startup />;
    }
    if (isAuthenticated && !isPasswordRecovery) {
      return <AppNavigator />;
    }
    return <AuthNavigator />;
<% } else { -%>
    return <AppNavigator />;
<% } -%>
  };

  return (
    <NavigationContainer ref={rootNavigationReference} theme={navigationTheme}>
      <I18nextProvider i18n={i18n}>{renderContent()}</I18nextProvider>
    </NavigationContainer>
  );
}

export default ApplicationNavigator;
