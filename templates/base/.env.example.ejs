# Copy to .env for local development (never commit real secrets).
# Use KEY=value only. After changing .env, restart Expo: npx expo start --clear

# --- EAS / Expo (fill from your Expo dashboard) ---
# EXPO_OWNER=your_expo_username
# EAS_PROJECT_ID=your_eas_project_id

<% if (hasAuth) { -%>
# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_anon_or_publishable_key

# --- Native Google Sign-In -> Supabase signInWithIdToken ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Optional iOS-only OAuth client id:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Apple Sign In: generate the Supabase "Secret" JWT locally and paste into
# Supabase dashboard (Authentication -> Providers -> Apple). See docs/NATIVE_AUTH_SETUP.md.
<% } -%>

# --- Optional: Sentry crash reporting (only enabled in production when DSN set) ---
# EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=<%= sentryOrg %>
# SENTRY_PROJECT=<%= sentryProject %>
# SENTRY_AUTH_TOKEN=   # eas secret:create --name SENTRY_AUTH_TOKEN

# APS_ENVIRONMENT is set automatically by EAS production builds.
